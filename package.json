{
  "name": "paletteget-mcp",
  "version": "0.1.0",
  "description": "MCP server for the PaletteGet color palette library: WCAG-checked palettes for App, Web and Mini App UIs, over stdio or a hosted HTTP endpoint.",
  "type": "module",
  "bin": {
    "paletteget-mcp": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.mjs",
    "smoke": "node smoke-test.mjs",
    "data": "node --import ./alias-loader.mjs build-data.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "undici": "^7.0.0"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "mcp",
    "palette",
    "color",
    "design-tokens",
    "wcag",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.151.3"
  },
  "homepage": "https://paletteget.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yang7206/paletteget-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/yang7206/paletteget-mcp/issues"
  }
}
